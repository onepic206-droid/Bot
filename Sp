local worldname = worldname(put your world)"    -- World to join
local dropY =                   -- Y position for drops
local maxX =                   -- Random X range (1 to maxX)
local BATCH_SIZE = 5            -- Max bots per batch (avoid proxy ban and rate limit limit)
-- ============================================

local PACK_ID = "LureBooster"
local PACK_COST = 100
local manager = getClient()

function randomSleep(minMs, maxMs)
    sleep(math.random(minMs, maxMs))
end

function processBot(bot)
    -- Wait for bot to be in PIXELSTATION (means tutorial is over)
    while bot:navigation() ~= "PIXELSTATION" do
        sleep(2000)
    end

    print(string.format("[LURE] Bot %s arrived at PIXELSTATION, proceeding...", bot.id))
    randomSleep(1000, 2000)

    -- Warp to world
    bot:warp(worldname)
    randomSleep(3000, 5000)

    local attempts = 0
    while bot:navigation() ~= worldname and attempts < 30 do
        sleep(1000)
        attempts = attempts + 1
    end

    if bot:navigation() ~= worldname then
        print(string.format("[LURE] Bot %s failed to enter %s", bot.id, worldname))
        return
    end

    print(string.format("[LURE] Bot %s entered %s successfully", bot.id, worldname))
    randomSleep(1000, 2000)

    -- PHASE 1: Buy all possible packs first
    print(string.format("[LURE] Bot %s starting purchase phase...", bot.id))
    local buyCount = 0
    while bot.gems >= PACK_COST do
        local startGems = bot.gems
        bot:buy(PACK_ID)
        
        local buyWait = 0
        while bot.gems >= startGems and buyWait < 20 do
            sleep(500)
            buyWait = buyWait + 1
        end

        if bot.gems >= startGems then
            print(string.format("[LURE] Bot %s: Purchase failed/timeout at pack #%d", bot.id, buyCount + 1))
            break
        end

        buyCount = buyCount + 1
        randomSleep(400, 800)
    end
    print(string.format("[LURE] Bot %s finished buying (%d packs)", bot.id, buyCount))

    if buyCount > 0 then
        -- PHASE 2: Move to a random drop location ONCE
        local randX = math.random(1, maxX)
        local targetPos = Vector2i.new(randX, dropY)
        bot:findPath(targetPos)
        
        local moveWait = 0
        while bot:pathfinding() and moveWait < 50 do
            sleep(200)
            moveWait = moveWait + 1
        end
        randomSleep(500, 1000)
        -- PHASE 3: Drop everything at once
        local items = bot:inventory().items
        local droppedAny = false
        for _, item in pairs(items) do
            if item.type == 7 and item.amount > 0 then
                print(string.format("[LURE] Bot %s dropping %d units of lure %d", bot.id, item.amount, item.id))
                bot:drop(item.id, item.type, item.amount)
                droppedAny = true
                randomSleep(400, 800)
            end
        end
      
        if not droppedAny then
            print(string.format("[LURE] Bot %s: Purchase phase completed but no lures found in inventory!", bot.id))
        end
    end
    print(string.format("[LURE] Bot %s finished work.", bot.id))
end
